# Domain (used by nginx + frontend NEXT_PUBLIC_API_BASE_URL)
DOMAIN=localhost

# VAPID keys for Web Push notifications.
# Generate with: python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); print(v.private_pem().decode()); print(v.public_pem().decode())"
# Or use: npx web-push generate-vapid-keys
SCANNER_VAPID_PUBLIC_KEY=
SCANNER_VAPID_PRIVATE_KEY=
SCANNER_VAPID_EMAIL=mailto:admin@example.com
