# ============================================================
# Scanner de Imagens — .gitignore
# ============================================================

# ---- Graphify (knowledge graph) ----
graphify-out/cache/
graphify-out/converted/
graphify-out/.graphify_root
# Mantém versionados: graph.json, graph.html, GRAPH_REPORT.md, wiki/
# Sub-runs do graphify (não deveriam existir mas guard contra hook bug)
src/**/graphify-out/
**/.graphify_python
**/.graphify_*.json

# ---- Pandoc auto-download (pypandoc) ----
pandoc-*.msi
pandoc-*.deb
pandoc-*.tar.gz
pandoc-*.dmg

# ---- Test scan logs (geram em runs do CLI) ----
scan-*.log
scan-test*.log
*.log

# ---- Notas órfãs do graphify com chars Unicode no nome ----
# Quando o graphify roda em arquivos sem ID claro, gera notas com docstring no nome
/Convers*.md

# ---- Pipeline de chats ----
# Staging area NÃO entra no git (chats podem conter info sensível)
claude-exports/
scripts/sync.log

# ---- Obsidian ----
# Versiona settings/plugins, ignora estado volátil (vault na raiz e/ou em vault/)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
vault/.obsidian/workspace.json
vault/.obsidian/workspace-mobile.json
vault/.obsidian/cache/
.trash/
vault/.trash/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# ---- IDE / editor ----
.idea/
.vscode/
*.swp
*.swo

# ---- Sistema operacional ----
Thumbs.db
desktop.ini
ehthumbs.db
.DS_Store

# ---- Vendored deps (clones de terceiros) ----
# Source clonada do Docling — não versionar no repo do app
docling-main/

# ---- Modelos de OCR (downloads externos) ----
# Tessdata é ~22MB; usuário baixa do tessdata_best repo
tessdata-portuguese/

# ---- Outputs do scanner ----
output/

# ---- Imagens de teste / dados grandes ----
samples/*.png
samples/*.jpg
samples/*.jpeg
samples/*.pdf
!samples/README.md
output/
docling-install.log
graphify-run.log

# Descomente quando criar a pasta:
# tests/fixtures/large/
# data/raw/

# ---- Secrets ----
.env
.env.local
*.pem
*.key
